# OfferBazaar Environment Variables Template
# Copy this file to server/.env and fill in your credentials.

# Application
PORT=5000
NODE_ENV=development
# Comma separated list of allowed frontend origins (production: your domain)
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/offerbazaar?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/offerbazaar

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin User Seed Credentials (read by seed.js)
ADMIN_NAME=OfferBazaar Admin
ADMIN_EMAIL=admin@offerbazaar.com
ADMIN_PASSWORD=Admin@OfferBazaar2026!
ADMIN_PHONE=+919876543210
ADMIN_CITY=Mumbai

# Offer Validation Pipeline Configuration (Phase 4)
# VALIDATION_MODE: 'auto' runs automated pipeline, 'manual' sends all offers to flagged_for_review
VALIDATION_MODE=auto
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
CLOUDINARY_MODERATION_ENABLED=false
