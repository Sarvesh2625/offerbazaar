# OfferBazaar Server Environment Variables
# Copy this file to server/.env and fill in your credentials.
# NEVER commit the real .env file (it is already git-ignored).

# Application
PORT=5000
NODE_ENV=development
# Comma separated list of allowed frontend origins.
# In production this MUST be your deployed frontend domain, e.g.
# CLIENT_URL=https://offerbazaar.vercel.app
CLIENT_URL=http://localhost:5173

# JWT Authentication
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=offerbazaar_super_secret_jwt_key_2026!
JWT_EXPIRES_IN=7d

# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/offerbazaar?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/offerbazaar

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin User Seed Credentials (read by seed.js)
ADMIN_NAME=OfferBazaar Admin
ADMIN_EMAIL=admin@offerbazaar.com
ADMIN_PASSWORD=Admin@OfferBazaar2026!
ADMIN_PHONE=+919876543210
ADMIN_CITY=Mumbai

# Offer Validation Pipeline Configuration (Phase 4)
# VALIDATION_MODE: 'auto' runs automated pipeline, 'manual' sends all offers to flagged_for_review
VALIDATION_MODE=auto
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# Without an LLM key every offer is routed to the manual review queue.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
CLOUDINARY_MODERATION_ENABLED=false

# Auth cookie SameSite policy.
# 'strict' (default) is correct when the API is reached through the same
# origin (the Vercel rewrite proxy). Use 'none' only when the API is called
# directly from a genuinely cross-site origin.
COOKIE_SAMESITE=strict
